<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Timechoose"
    android:background="@color/lightgrey">


    <TextView
        android:id="@+id/headtxttitle"
        android:layout_width="0dp"
        android:layout_height="61dp"
        android:layout_marginStart="4dp"
        android:gravity="left"
        android:padding="15dp"
        android:text=""
        android:fontFamily="monospace"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageView1"
        app:layout_constraintTop_toTopOf="parent"></TextView>

    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="53dp"
        android:layout_height="61dp"
        android:layout_margin="12dp"
        android:src="@drawable/nielogo"
        app:layout_constraintBottom_toBottomOf="@+id/view2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headtxttitle" />

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="3dp"
        android:background="@color/maroon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headtxttitle" />


    <TextView
        android:id="@+id/datep"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="30dp"
        android:background="@drawable/button"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:paddingStart="30dp"
        android:text=""
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintBottom_toTopOf="@+id/timep"
        tools:layout_editor_absoluteX="16dp" />

    <TextView
        android:id="@+id/timep"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="30dp"
        android:background="@drawable/button"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:paddingStart="30dp"
        android:text=""
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/catpick"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="30dp"
        android:layout_height="80dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/button"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:paddingStart="30dp"
        android:text=""
        android:visibility="visible"
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@+id/timep"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="96dp"
        android:background="@drawable/button"
        android:gravity="center"
        android:padding="15dp"
        android:text="Done"
        android:textColor="@color/black"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/footer1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingRight="15dp"
        android:text="© 2024 Timetable Seeker"
        android:textColor="@color/white"
        android:gravity="center_vertical|end"
        android:textSize="14sp"
        android:background="@color/maroon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>